{
    "name": "efabrica/neoforms",
    "description": "Better way to render forms",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nette/forms": "^3.3",
        "nette/application": "^3.2",
        "latte/latte": "^3.1.4",
        "tracy/tracy": "^2.9"
    },
    "suggest": {
        "nette/database": "Required only when using ActiveRowForm to build forms from Nette\\Database\\Table\\ActiveRow (^3.1)",
        "radekdostal/nette-datetimepicker": "Required only when using addDatePicker()/addDateTimePicker() (^3.1)"
    },
    "config": {
        "platform": {
            "php": "8.3.9"
        }
    },
    "autoload": {
        "psr-4": {
            "Efabrica\\NeoForms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Efabrica\\NeoForms\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Richard Popelis",
            "email": "richard@popelis.sk"
        }
    ],
    "require-dev": {
        "radekdostal/nette-datetimepicker": "^3.1",
        "nette/database": "^3.1",
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpunit/phpunit": "^10.3"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "php -d memory_limit=-1 .github/phpstan/vendor/bin/phpstan analyse -c .github/phpstan/vendor/efabrica/phpstan-config/conf/nette-lib/level.8.neon",
        "cs": "php .github/phpstan/vendor/bin/phpcs src --standard=.github/phpstan/vendor/efabrica/coding-standard/eFabrica --extensions=php -n",
        "cbf": "php .github/phpstan/vendor/bin/phpcbf src --standard=.github/phpstan/vendor/efabrica/coding-standard/eFabrica --extensions=php"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "phpstan": "Run PHPStan level 8 (first: composer install --working-dir=.github/phpstan)",
        "cs": "Check coding standard (first: composer install --working-dir=.github/phpstan)",
        "cbf": "Auto-fix coding standard violations"
    }
}
